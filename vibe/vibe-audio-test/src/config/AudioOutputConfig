#pragma once

// -----------------------------------------------------------------------------
// AudioOutputConfig.h — Configuración de salida de audio (A2DP)
// -----------------------------------------------------------------------------

// Nombre EXACTO del dispositivo Bluetooth (ajústalo si el tuyo anuncia otro)
#ifndef BT_SPEAKER_NAME
#define BT_SPEAKER_NAME "HCW Music"
#endif

// Tamaño del ring buffer (bytes) para la salida PCM hacia A2DP.
// Subido para mayor tolerancia a jitter WiFi (antes 32768).
#ifndef AUDIO_BUFFER_SIZE
#define AUDIO_BUFFER_SIZE 16384
#endif

// Formato PCM esperado desde el servidor (test_speaker.py)
#ifndef PCM_SAMPLE_RATE
#define PCM_SAMPLE_RATE 44100   // Hz
#endif

#ifndef PCM_CHANNELS
#define PCM_CHANNELS 2          // estéreo
#endif

#ifndef PCM_SAMPLE_WIDTH_BYTES
#define PCM_SAMPLE_WIDTH_BYTES 2 // s16le
#endif

// Volumen A2DP por defecto (0..127)
#ifndef A2DP_DEFAULT_VOLUME
#define A2DP_DEFAULT_VOLUME 80
#endif
