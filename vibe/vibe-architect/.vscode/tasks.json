{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$esbuild-watch"
      ]
    }
  ],
  "problemMatchers": [
    {
      "name": "esbuild-watch",
      "owner": "esbuild-watch",
      "fileLocation": [
        "relative",
        "${workspaceFolder}"
      ],
      "pattern": [
        {
          "regexp": "\\[watch\\] build started",
          "kind": "file",
          "file": "1"
        },
        {
          "regexp": "✘ \\[ERROR\\] (.*)",
          "kind": "file",
          "message": 1
        },
        {
          "regexp": "\\s+(.*):(\\d+):(\\d+):",
          "kind": "location",
          "file": 1,
          "line": 2,
          "column": 3,
          "loop": false
        },
        {
          "regexp": "\\[watch\\] build finished",
          "kind": "file"
        }
      ],
      "background": {
        "activeOnStart": true,
        "beginsPattern": {
          "regexp": "\\[watch\\] build started"
        },
        "endsPattern": {
          "regexp": "\\[watch\\] build finished"
        }
      }
    }
  ]
}